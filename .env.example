# Application configuration. Copy to .env for local use; never commit .env.
APP_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=2.0.0

# Monitoring profile (docker compose --profile monitoring) needs a Grafana
# admin login. Set GF_SECURITY_ADMIN_USER and GF_SECURITY_ADMIN_PASSWORD in
# your own .env — generate the password once with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# Compose fails to start Grafana unless both variables are present.

# Tracing. The app exports OTLP traces when this endpoint is set; the
# monitoring profile provides the collector at this address.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Alerts. To route Prometheus alerts to Slack or Discord, set
# ALERT_WEBHOOK_URL in your own .env: a Slack incoming webhook URL, or a
# Discord webhook URL ending in /slack. Leave it unset to keep alerts in
# the Alertmanager UI.
