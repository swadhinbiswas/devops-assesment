# Application configuration. Copy to .env for local use; never commit .env.
APP_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# Monitoring profile (docker compose --profile monitoring) needs a Grafana
# admin login. Set GF_SECURITY_ADMIN_USER and GF_SECURITY_ADMIN_PASSWORD in
# your own .env — generate the password once with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# Compose fails to start Grafana unless both variables are present.
