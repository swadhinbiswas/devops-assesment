// Docker service discovery finds every container on the host.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Keep only the labels that identify the source; everything else stays
// out of the index.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.app_logs.receiver]
}

// Parse the app's JSON logs. Only level and path become indexed labels;
// both are low-cardinality (a few levels, bounded route templates).
// The original JSON line remains intact for message and trace fields.
loki.process "app_logs" {
  // Parse only the app container's JSON; logs from other containers pass
  // through unchanged. This avoids indexing arbitrary JSON fields.
  stage.match {
    selector = "{service=\"app\"}"

    stage.json {
      expressions = {
        level = "level",
        path  = "path",
      }
    }

    stage.labels {
      values = {
        level = "level",
        path  = "path",
      }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
